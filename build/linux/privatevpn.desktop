# Install: copy privatevpn to /usr/local/bin (or ~/.local/bin), this file to
# ~/.local/share/applications/ and icon.png to
# ~/.local/share/icons/hicolor/256x256/apps/privatevpn.png
[Desktop Entry]
Type=Application
Name=PrivateVPN
GenericName=VPN gateway
Comment=Private VPN gateways for your own devices
Exec=privatevpn
Icon=privatevpn
Terminal=false
Categories=Network;
Keywords=VPN;WireGuard;gateway;
StartupNotify=false
